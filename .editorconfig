root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[{Makefile,*.mk}]
indent_style = tab

[*.sh]
binary_next_line = true
switch_case_indent = true
function_next_line = false
shell_variant = bash
simplify = true
space_redirects = true

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
